#!/bin/bash
# =================================================================
# GrubZilla - Panel Sterowania XXL (Finalna Poprawka Ikon)
# =================================================================

# 1. Definicja ikony głównej okna
MAIN_ICON="/usr/share/icons/hicolor/64x64/apps/grubzilla.png"
[ ! -f "$MAIN_ICON" ] && MAIN_ICON="system-run"

# 2. Definicja ikon dla wierszy (Pełne ścieżki są najpewniejsze)
# Jeśli masz własne ikony w tym folderze, YAD je teraz łyknie bez problemu
# 2. Definicja ikon dla wierszy (Podajemy PEŁNE ścieżki do plików PNG)
# 2. Definicja ikon dla wierszy (Podajemy TYLKO PEŁNE ścieżki)
PATH_ICO="/usr/share/icons/hicolor/64x64/apps"

ICO_MAIN="$PATH_ICO/grubzilla.png"
ICO_REFRESH="$PATH_ICO/aktualizator.png"
ICO_CLEAR="$PATH_ICO/usuwator.png"
ICO_SEARCH="$PATH_ICO/weryfikator-usb.png"
ICO_HELP="$PATH_ICO/help.png"

# Sprawdzenie, czy główny plik istnieje, jeśli nie - dajemy zamiennik
[ ! -f "$ICO_MAIN" ] && ICO_MAIN="system-run"
[ ! -f "$ICO_REFRESH" ] && ICO_REFRESH="view-refresh"
[ ! -f "$ICO_CLEAR" ] && ICO_CLEAR="edit-clear"
[ ! -f "$ICO_SEARCH" ] && ICO_SEARCH="zoom-search"
[ ! -f "$ICO_HELP" ] && ICO_HELP="help-browser"


# 3. Wyświetlanie listy
WYBOR=$(yad --list --title="GrubZilla - Panel Sterowania" \
    --window-icon="$MAIN_ICON" \
    --width=900 --height=550 --center --fixed \
    --image-column=1 \
    --text="<span size='x-large' weight='bold' color='#2e7d32'>Witaj w GrubZilla!</span>\n<span size='large'>Wybierz zadanie do wykonania:</span>" \
    --text-align=center \
    --column="":IMG --column="Zadanie":TEXT --column="Opis":TEXT \
    "$ICO_MAIN" "<span size='large' weight='bold'>GrubZilla</span>" "<span size='medium'>Formatuj USB / Nadaj nazwę systemu / Uaktualnij GRUB itd.</span>" \
    "$ICO_REFRESH" "<span size='large' weight='bold'>Aktualizator GRUB</span>" "<span size='medium'>Dodaj konfiguracje wszystkich OS/Linux z USB do GRUB</span>" \
    "$ICO_CLEAR" "<span size='large' weight='bold'>Usuwator GRUB</span>" "<span size='medium'>Usuń wszystkie wpisy z menu GRUB (programu GrubZilla)</span>" \
    "$ICO_SEARCH" "<span size='large' weight='bold'>Weryfikator USB</span>" "<span size='medium'>Weryfikuj USB czy jest zgodny (UUID) z konfiguracją GRUB</span>" \
    "$ICO_HELP" "<span size='large' weight='bold'>Instrukcja obsługi</span>" "<span size='medium'>Otwórz dokumentację w przeglądarce (PDF)</span>" \
    --print-column=2 --no-headers --separator="" --ellipsize=NONE --expand-column=3)

# 4. Obsługa wyboru
case "$WYBOR" in
    *"GrubZilla"*) /usr/bin/grubzilla ;;
    *"Aktualizator GRUB"*) /usr/bin/aktualizator-GRUB ;;
    *"Usuwator GRUB"*) /usr/bin/usuwator-GRUB ;;
    *"Weryfikator USB"*) /usr/bin/weryfikator-usb ;;
    *"Instrukcja obsługi"*) xdg-open /usr/share/doc/grubzilla/grubzilla.pdf ;;
    *) exit 0 ;;
esac
