#!/bin/bash
# =================================================================
# usuwator_GRUB.sh - Pełna Wersja Graficzna (Naprawiona)
# =================================================================

if [[ $EUID -ne 0 ]]; then
    pkexec env DISPLAY=$DISPLAY XAUTHORITY=$XAUTHORITY "$0" "$@"
    exit $?
fi

GRUB_FILE="/etc/grub.d/40_custom"

# --- Sprawdzenie, czy plik istnieje ---
if [ ! -f "$GRUB_FILE" ]; then
    zenity --error --title="Błąd" --text="Plik $GRUB_FILE nie istnieje."
    exit 1
fi

# --- Sprawdzenie, czy jest coś do roboty ---
if ! grep -qE "### GRUBZILLA START ###|menuentry.*CloneZilla" "$GRUB_FILE"; then
    zenity --info --title="GrubZilla" --text="Nie znaleziono żadnych wpisów do usunięcia. Twój GRUB jest czysty."
    exit 0
fi

# --- Potwierdzenie użytkownika ---
zenity --question --title="Usuwanie wpisów" --text="Czy na pewno chcesz usunąć wszystkie wpisy GrubZilla z menu GRUB?\nZostanie utworzona kopia zapasowa pliku." --width=350 || exit 0

# --- Wyznaczanie ścieżek PRZED blokiem postępu ---
REAL_USER=$(logname 2>/dev/null || echo $USER)
[ "$REAL_USER" == "root" ] && REAL_USER=$(who | awk '{print $1}' | head -n1)
USER_HOME=$(getent passwd "$REAL_USER" | cut -d: -f6)
TIMESTAMP=$(date +%Y%m%d_%H%M%S)
BACKUP_PATH="$USER_HOME/40_custom_backup_$TIMESTAMP"

# --- OPERACJE ---
(
echo "10"; echo "# Tworzę kopię zapasową w $USER_HOME..."
cp "$GRUB_FILE" "$BACKUP_PATH"
chown "$REAL_USER:$REAL_USER" "$BACKUP_PATH"

echo "40"; echo "# Usuwanie wpisów z pliku systemowego..."
# Tutaj dzieje się magia usuwania:
sed -i '/### GRUBZILLA START ###/,/### GRUBZILLA KONIEC ###/d' "$GRUB_FILE"
sed -i '/menuentry "CloneZilla/,/^}/d' "$GRUB_FILE"
sed -i '/^$/N;/^\n$/D' "$GRUB_FILE"
chmod 755 "$GRUB_FILE"

echo "60"; echo "# Aktualizacja menu GRUB (to potrwa chwilę)..."
update-grub > /dev/null 2>&1

echo "100"; echo "# Wszystkie operacje zakończone!"
) | zenity --progress --title="Usuwator GrubZilla" --text="Przygotowanie..." --auto-close --pulsate

# --- FINAŁ ---
zenity --info --title="Sukces" \
--text="Czyszczenie zakończone pomyślnie!\n\nKopia zapasowa Twojego starego pliku:\n<b>$BACKUP_PATH</b>" --width=450

exit 0
