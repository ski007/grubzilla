#!/bin/bash
# =================================================================
# WERYFIKATOR / SYNCHRONIZATOR USB - Wersja Graficzna
# Sprawdza czy menu GRUB pasuje do wpiętego USB.
# =================================================================

# --- AUTOMATYCZNE PODNOSZENIE UPRAWNIEŃ ---
if [[ $EUID -ne 0 ]]; then
    # Sprawdzamy, czy mamy dostęp do pkexec
    pkexec env DISPLAY=$DISPLAY XAUTHORITY=$XAUTHORITY "$0" "$@"
    exit $?
fi

# ... reszta Twojego skryptu ...

GRUB_CUSTOM="/etc/grub.d/40_custom"
MOUNT_ISO_DIR="/mnt/clonezilla_iso_temp"

# --- Sprawdzenie ROOT ---
if [[ $EUID -ne 0 ]]; then
    zenity --error --title="Error" --text="Run the program as root (sudo)."
    exit 1
fi

# --- Wykrywanie USB ---
while true; do
    USB_ISO_PART=$(blkid -L "CLONEZILLA")
    
    if [ -z "$USB_ISO_PART" ]; then
         LISTA_USB=$(lsblk -dno NAME,SIZE,MODEL,TRAN | grep "usb" | awk '{printf "%s\n%s\n%s\n%s\n", $1, $2, $3, $4}')
        
        if [ -z "$LISTA_USB" ]; then
            zenity --question --title="Verifier GrubZilla" \
                --text="❌ The GrubZilla USB drive was not found.\n\nPlug it in and click ‘Yes’ to try again."
            if [ $? -ne 0 ]; then exit 1; fi
            continue
        fi

        WYBOR=$(echo "$LISTA_USB" | zenity --list \
            --title="Verifier - USB selection" \
            --text="Select a USB device for verification:" \
            --column="Disk" --column="Size" --column="Model" --column="Type" \
            --width=600 --height=300)
        
        if [ $? -ne 0 ] || [ -z "$WYBOR" ]; then exit 1; fi
        USB_DISK=$(echo "$WYBOR" | cut -d'|' -f1)
        USB_ISO_PART="/dev/${USB_DISK}1"
    fi
    break
done

# --- Akcja ---
mkdir -p "$MOUNT_ISO_DIR"
if ! mount "$USB_ISO_PART" "$MOUNT_ISO_DIR"; then
    zenity --error --text="The partition could not be mounted $USB_ISO_PART"
    exit 1
fi

UUID_USB=$(blkid -s UUID -o value "$USB_ISO_PART")

# --- LOGIKA WERYFIKACJI ---
if grep -q "ID_USB:$UUID_USB" "$GRUB_CUSTOM"; then
    zenity --info --title="GrubZilla - OK" --width=350 \
        --text="✅ The GRUB menu is now up to date for this USB drive.\nYou don't have to do anything"
else
    # Jeśli nie pasuje, pytamy o synchronizację
    zenity --question --title="Synchronization required" \
        --text="🔄 Another USB drive was detected, or there are no entries in GRUB.\n\nDo you want to sync the menu with this USB drive?"
    
    if [ $? -eq 0 ]; then
        if [ -f "$MOUNT_ISO_DIR/grubzilla_full_config.txt" ]; then
            (
            echo "20"; echo "# Deleting old entries..."
            sed -i '/### GRUBZILLA START ###/,/### GRUBZILLA KONIEC ###/d' "$GRUB_CUSTOM"
            
            echo "50"; echo "# Copying the new configuration from USB..."
            cat "$MOUNT_ISO_DIR/grubzilla_full_config.txt" >> "$GRUB_CUSTOM"
            
            echo "80"; echo "# Updating the GRUB menu..."
            update-grub &>/dev/null
            echo "100"; echo "# All done!"
            ) | zenity --progress --title="Synchronisation" --text="Updating..." --auto-close
            
            zenity --info --text="✅ The GRUB menu has been updated for this specific USB drive."
        else
            zenity --error --text="❌ ERROR: The file “grubzilla_full_config.txt” is missing from this USB drive.\n\nFirst, use the option 'Updater-Grub'."
        fi
    fi
fi

umount "$MOUNT_ISO_DIR"
rmdir "$MOUNT_ISO_DIR"
exit 0
